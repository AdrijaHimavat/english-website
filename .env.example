# Public site origin, without a trailing slash. Defaults to https://growme.blog in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_... or legacy service_role). Server only, never expose it in the browser.
SUPABASE_SECRET_KEY=

# Stripe (Developers → API keys / Webhooks). Secret values: set them in Vercel, never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Course price in the smallest currency unit (1700 = 17.00). Buyers see it converted to their currency.
COURSE_PRICE_CENTS=1700
COURSE_PRICE_CURRENCY=usd
